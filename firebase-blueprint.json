{
  "entities": {
    "Buyer": {
      "title": "Buyer",
      "description": "Permanent customer record with verified delivery coordinates",
      "type": "object",
      "properties": {
        "buyerCode": {
          "type": "string",
          "description": "Unique alphanumeric business code",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "buyerName": {
          "type": "string",
          "description": "Registered name of the buyer/customer",
          "minLength": 2,
          "maxLength": 128
        },
        "latitude": {
          "type": "number",
          "description": "WGS84 latitude coordinate"
        },
        "longitude": {
          "type": "number",
          "description": "WGS84 longitude coordinate"
        }
      },
      "required": ["buyerCode", "buyerName", "latitude", "longitude"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Registered delivery fleet driver",
      "type": "object",
      "properties": {
        "driverId": {
          "type": "string",
          "description": "Unique identifier for the driver",
          "minLength": 2,
          "maxLength": 64
        },
        "driverName": {
          "type": "string",
          "description": "Full name of the driver",
          "minLength": 2,
          "maxLength": 128
        },
        "maximumLoadKg": {
          "type": "number",
          "description": "Nominal vehicle payload capacity in kilograms"
        },
        "active": {
          "type": "boolean",
          "description": "Whether driver is active for route optimization"
        }
      },
      "required": ["driverId", "driverName", "maximumLoadKg", "active"]
    },
    "GlobalSettings": {
      "title": "GlobalSettings",
      "description": "Global operational settings including warehouse depot coordinates",
      "type": "object",
      "properties": {
        "depotLatitude": {
          "type": "number",
          "description": "Depot warehouse WGS84 latitude"
        },
        "depotLongitude": {
          "type": "number",
          "description": "Depot warehouse WGS84 longitude"
        },
        "depotName": {
          "type": "string",
          "description": "Name of the central depot/warehouse",
          "maxLength": 128
        },
        "distanceWeightPercent": {
          "type": "number",
          "description": "Weight of road distance minimization in optimization (0-100)"
        },
        "loadBalanceWeightPercent": {
          "type": "number",
          "description": "Weight of load balance in optimization (0-100)"
        },
        "capacityTolerancePercent": {
          "type": "number",
          "description": "Hard operational buffer percentage (default 10%)"
        }
      },
      "required": ["depotLatitude", "depotLongitude"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Operational user profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth User UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "role": {
          "type": "string",
          "description": "User operational role (default: DISPATCHER)"
        },
        "isActive": {
          "type": "boolean",
          "description": "Account active flag"
        }
      },
      "required": ["uid", "email"]
    },
    "ApprovedDistribution": {
      "title": "ApprovedDistribution",
      "description": "Append-only immutable snapshot of a formally approved distribution plan",
      "type": "object",
      "properties": {
        "distributionId": {
          "type": "string",
          "description": "Unique identifier for the distribution snapshot",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of plan generation"
        },
        "approvedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of formal dispatcher approval"
        },
        "approvedBy": {
          "type": "string",
          "description": "Email or display name of dispatcher who approved the distribution"
        },
        "revision": {
          "type": "integer",
          "description": "Server-authoritative atomic sequence number",
          "minimum": 1
        },
        "depot": {
          "type": "object",
          "description": "Depot warehouse location",
          "required": ["latitude", "longitude"]
        },
        "drivers": {
          "type": "array",
          "description": "Fleet drivers active in this distribution"
        },
        "routes": {
          "type": "array",
          "description": "Final road routes assigned to drivers"
        },
        "stops": {
          "type": "array",
          "description": "All customer delivery stops included in routes"
        },
        "unassigned": {
          "type": "array",
          "description": "Unassigned delivery stops"
        },
        "metrics": {
          "type": "object",
          "description": "Comprehensive operational metrics and objective breakdown"
        },
        "optimizationScore": {
          "type": "number",
          "description": "Final combined optimization objective score"
        },
        "warnings": {
          "type": "array",
          "description": "Domain warnings recorded during approval"
        }
      },
      "required": ["distributionId", "createdAt", "approvedAt", "revision", "depot", "drivers", "routes", "stops", "unassigned", "metrics", "optimizationScore", "warnings"]
    },
    "AtomicSequenceCounter": {
      "title": "AtomicSequenceCounter",
      "description": "Server-side atomic sequence counter for monotonically increasing distribution revisions",
      "type": "object",
      "properties": {
        "currentRevision": {
          "type": "integer",
          "description": "Latest assigned revision number",
          "minimum": 1
        },
        "lastApprovedDistributionId": {
          "type": "string",
          "description": "ID of the last approved distribution snapshot"
        },
        "lastUpdatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of the last revision increment"
        }
      },
      "required": ["currentRevision"]
    },
    "AuditEvent": {
      "title": "AuditEvent",
      "description": "Immutable audit trail event for operational, export, and approval tracking",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Unique identifier of the audit log event"
        },
        "eventType": {
          "type": "string",
          "description": "Classification of the event"
        },
        "userId": {
          "type": "string",
          "description": "Authenticated user ID who triggered the action"
        },
        "userEmail": {
          "type": "string",
          "description": "Email address of the user at event time"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of the event"
        },
        "distributionId": {
          "type": "string",
          "description": "Referenced distribution ID if applicable"
        },
        "revision": {
          "type": "number",
          "description": "Referenced distribution sequence revision number"
        },
        "metadata": {
          "type": "object",
          "description": "Contextual operational event metadata"
        }
      },
      "required": ["eventId", "eventType", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/buyers/{buyerCode}": {
      "schema": "Buyer",
      "description": "Permanent master customer directory"
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Delivery driver and vehicle fleet registry"
    },
    "/settings/{settingId}": {
      "schema": "GlobalSettings",
      "description": "System-wide parameters and central depot location"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated dispatcher users"
    },
    "/distributions/{distributionId}": {
      "schema": "ApprovedDistribution",
      "description": "Append-only immutable snapshots of formally approved distributions"
    },
    "/counters/{counterId}": {
      "schema": "AtomicSequenceCounter",
      "description": "Atomic sequence counters for transactional revision numbers"
    },
    "/auditEvents/{eventId}": {
      "schema": "AuditEvent",
      "description": "Append-only immutable event logs for security auditability"
    }
  }
}
